</mxCell>
        <mxCell id="14" value="TẦNG 2: TRẠM THU BIÊN ĐA KÊNH (MULTI-CHANNEL LORA GATEWAY - CM4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#38bdf8;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=26;fontColor=#0369a1;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
  <mxGeometry x="80" y="520" width="2090" height="280" as="geometry" />
</mxCell>
        <mxCell id="15" value="3x Module SX1278 (SPI0)&#xa;• CH1: 433.175 MHz&#xa;• CH2: 433.375 MHz&#xa;• CH3: 433.575 MHz&#xa;Thu đồng thời 3 kênh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=24;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
  <mxGeometry x="130" y="590" width="550" height="140" as="geometry" />
</mxCell>
        <mxCell id="16" value="Gateway Manager Daemon&#xa;• Nhận ngắt DIO0 đa luồng&#xa;• Bóc tách Header/Payload&#xa;• Đọc thanh ghi đo RSSI, SNR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=24;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
  <mxGeometry x="780" y="590" width="590" height="140" as="geometry" />
</mxCell>
        <mxCell id="17" value="CSDL Log &amp; Data Dispatcher&#xa;• Ghi nhật ký đo đạc CSV&#xa;• Web Dashboard theo dõi&#xa;• Stream dữ liệu sang Server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=2;fontColor=#5b21b6;fontSize=24;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
  <mxGeometry x="1470" y="590" width="640" height="140" as="geometry" />
</mxCell>
        <mxCell id="18" value="Tín hiệu RF" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f172a;strokeWidth=2.5;endArrow=block;endFill=1;fontColor=#0f172a;fontSize=22;fontStyle=1;fontFamily=Helvetica;" edge="1" parent="1" source="15" target="16">
