</mxCell>
        <mxCell id="8" value="Nhật ký kênh (CSV Logs)&#xa;• Chuỗi thời gian CSI (10x9)&#xa;• Lịch sử RSSI, SNR, mất gói" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=2;fontColor=#5b21b6;fontSize=24;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
  <mxGeometry x="650" y="175" width="430" height="140" as="geometry" />
</mxCell>
        <mxCell id="9" value="TensorFlow / Keras Training&#xa;• Tiền xử lý &amp; StandardScaler&#xa;• Huấn luyện 5 kiến trúc nơ-ron&#xa;• 500 Epochs hội tụ chuẩn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=2;fontColor=#5b21b6;fontSize=24;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
  <mxGeometry x="1170" y="175" width="450" height="140" as="geometry" />
</mxCell>
        <mxCell id="10" value="TFLite Converter &amp; Exporter&#xa;• Lượng tử hóa FlatBuffer&#xa;• Sinh mã C Header model.h&#xa;• Căn chỉnh alignas(16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=2;fontColor=#9f1239;fontSize=24;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
