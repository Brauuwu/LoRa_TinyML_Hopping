        <mxCell id="4" value="Luồng dữ liệu vô tuyến &amp; CSI&#xa;(End-Node -&gt; Gateway -&gt; Server)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=2;fontColor=#1e293b;fontSize=24;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
