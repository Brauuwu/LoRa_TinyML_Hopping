        <mxCell id="6" value="Vòng lặp suy luận tự chủ&#xa;(Thực thi nội bộ trên ESP32)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#15803d;fontSize=24;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
