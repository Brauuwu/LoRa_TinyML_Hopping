        <mxCell id="2" value="NGUYÊN LÝ ĐIỀU CHẾ TRẢI PHỔ CHIRP (LORA CHIRP SPREAD SPECTRUM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=15;shadow=1;arcSize=10;" vertex="1" parent="1">
  <mxGeometry x="50" y="20" width="900" height="40" as="geometry" />
</mxCell>
        <mxCell id="3" value="DỮ LIỆU NHỊ PHÂN
(Binary Bitstream)
1 0 1 1 0 ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=11;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="60" y="110" width="150" height="75" as="geometry" />
</mxCell>
        <mxCell id="4" value="NHÓM SF BIT
(Mã hóa Symbol)
Ký hiệu k ∈ [0, 2^SF - 1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0369a1;fontSize=11;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="250" y="110" width="160" height="75" as="geometry" />
</mxCell>
        <mxCell id="5" value="BỘ TẠO CHIRP CSS
(Frequency Sweeping)
f(t) = f_start + (BW / T_s) * t" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#15803d;fontSize=11;arcSize=8;" vertex="1" parent="1">
