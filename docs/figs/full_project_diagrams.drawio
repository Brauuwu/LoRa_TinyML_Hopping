        <mxCell id="3" value="VI ĐIỀU KHIỂN ESP32 DEVKIT V1 (Xtensa Dual-Core 32-bit LX6 @ 240 MHz) SRAM: 520 KB | Flash: 4 MB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#bae6fd;strokeWidth=1.5;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#0369a1;arcSize=6;" vertex="1" parent="1">
