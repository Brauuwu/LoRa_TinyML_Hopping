        <mxCell id="13" value="Tần số cao (f_0 + BW/2)   Tần số tâm (f_0 = 433.x MHz)   Tần số thấp (f_0 - BW/2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=11;arcSize=8;" vertex="1" parent="1">
