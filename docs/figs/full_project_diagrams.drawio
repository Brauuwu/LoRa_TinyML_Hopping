        <mxCell id="4" value="MODULE THU #1 (KÊNH 1 - 433.175 MHz) - MOSI ──&gt; Pin 19 (GPIO 10) - MISO &lt;── Pin 21 (GPIO 9) - SCLK ──&gt; Pin 23 (GPIO 11) - NSS  ──&gt; Pin 24 (GPIO 8 - SPI CE0) - DIO0 &lt;── Pin 18 (GPIO 24 - Ngắt RxDone)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0369a1;fontSize=11;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="60" y="100" width="260" height="130" as="geometry" />
</mxCell>
        <mxCell id="5" value="MODULE THU #2 (KÊNH 2 - 433.375 MHz) - MOSI ──&gt; Pin 19 (GPIO 10) - MISO &lt;── Pin 21 (GPIO 9) - SCLK ──&gt; Pin 23 (GPIO 11) - NSS  ──&gt; Pin 26 (GPIO 7 - SPI CE1) - DIO0 &lt;── Pin 16 (GPIO 23 - Ngắt RxDone)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#15803d;fontSize=11;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="60" y="260" width="260" height="130" as="geometry" />
</mxCell>
        <mxCell id="6" value="MODULE THU #3 (KÊNH 3 - 433.575 MHz) - MOSI ──&gt; Pin 19 (GPIO 10) - MISO &lt;── Pin 21 (GPIO 9) - SCLK ──&gt; Pin 23 (GPIO 11) - NSS  ──&gt; Pin 22 (GPIO 25 - Soft CS) - DIO0 &lt;── Pin 15 (GPIO 22 - Ngắt RxDone)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontColor=#b45309;fontSize=11;arcSize=8;" vertex="1" parent="1">
