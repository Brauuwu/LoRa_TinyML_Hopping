        <mxCell id="8" value="3 LUỒNG WORKER THU ĐỘC LẬP - Thread 1: Lắng nghe CH1 433.175 - Thread 2: Lắng nghe CH2 433.375 - Thread 3: Lắng nghe CH3 433.575 Khả năng thu 100% không nghẽn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#6366f1;strokeWidth=1.5;fontColor=#4338ca;fontSize=11;arcSize=8;" vertex="1" parent="1">
