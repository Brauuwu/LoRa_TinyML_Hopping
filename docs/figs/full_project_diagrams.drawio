        <mxCell id="10" value="TFLite Converter &amp; Exporter&#xa;• Lượng tử hóa mô hình FlatBuffer&#xa;• Sinh mã C Header model.h&#xa;• Định dạng bộ nhớ alignas(16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=2;fontColor=#9f1239;fontSize=24;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
