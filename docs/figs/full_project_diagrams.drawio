        <mxCell id="4" value="MODULE SEMTECH SX1278 (RA-02) Băng tần: 433 MHz ISM Công suất: +17 dBm (PA_BOOST) Giao tiếp: VSPI Hardware Bus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#bbf7d0;strokeWidth=1.5;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#15803d;arcSize=6;" vertex="1" parent="1">
