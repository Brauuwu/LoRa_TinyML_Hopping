</mxCell>
        <mxCell id="7" value="Task_TinyML (Mức ưu tiên 2) - Chuẩn hóa Z-Score bộ đệm 10x9 - Thực thi suy luận TFLite Micro (&lt; 10 ms) - ArgMax xác định kênh sạch nhất" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#15803d;fontSize=11;arcSize=8;" vertex="1" parent="1">
