        <mxCell id="20" value="CSV Stream qua TCP/IP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f172a;strokeWidth=2.5;endArrow=block;endFill=1;fontColor=#0f172a;fontSize=22;fontStyle=1;fontFamily=Helvetica;" edge="1" parent="1" source="17" target="8">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
        <mxCell id="21" value="Vai trò trạm thu: Tiếp nhận gói tin từ mọi kênh, bóc tách chỉ số truyền thông và truyền về máy chủ phân tích" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=2;fontColor=#1e293b;fontSize=24;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
  <mxGeometry x="120" y="605" width="1610" height="40" as="geometry" />
</mxCell>
        <mxCell id="22" value="TẦNG 3: THIẾT BỊ ĐẦU CUỐI IOT BIÊN (EDGE TINYML END-NODE - ESP32)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#4ade80;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=26;fontColor=#15803d;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
  <mxGeometry x="80" y="700" width="1690" height="470" as="geometry" />
</mxCell>
        <mxCell id="23" value="Khối Quản Lý Dữ Liệu (Manager)&#xa;• Cảm biến môi trường (Telemetry)&#xa;• Bộ đệm trượt FIFO (10 bước x 9 đặc trưng)&#xa;• Chuẩn hóa Z-Score O(1) theo SCALER tĩnh&#xa;• Khóa Mutex đồng bộ FreeRTOS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#15803d;fontSize=24;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
  <mxGeometry x="120" y="765" width="480" height="260" as="geometry" />
</mxCell>
        <mxCell id="24" value="Nhân Suy Luận Biên (TFLM Engine)&#xa;• Mảng FlatBuffer model.h trong Flash&#xa;• Vùng đệm Tensor Arena (10 KB RAM tĩnh)&#xa;• Bộ tính toán mạng nơ-ron (Forward Pass)&#xa;• Quyết định kênh tối ưu: k = ArgMax" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#15803d;fontSize=24;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
  <mxGeometry x="670" y="765" width="530" height="260" as="geometry" />
</mxCell>
        <mxCell id="25" value="Khối Truyền Thông Vô Tuyến&#xa;• Module LoRa SX1278 (Ra-02)&#xa;• Tự động chỉnh tần số sang kênh k&#xa;• Khuếch đại công suất (+17 dBm)&#xa;• Kích hoạt phát gói tin Uplink" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=24;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
  <mxGeometry x="1270" y="765" width="460" height="260" as="geometry" />
</mxCell>
        <mxCell id="26" value="Vector đặc trưng (90)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2.5;endArrow=block;endFill=1;fontColor=#15803d;fontSize=22;fontStyle=1;fontFamily=Helvetica;" edge="1" parent="1" source="23" target="24">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
        <mxCell id="27" value="Chỉ số kênh k" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2.5;endArrow=block;endFill=1;fontColor=#15803d;fontSize=22;fontStyle=1;fontFamily=Helvetica;" edge="1" parent="1" source="24" target="25">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
        <mxCell id="28" value="Nạp mã nguồn C header model.h vào Flash" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2.5;endArrow=block;endFill=1;fontColor=#b91c1c;fontSize=22;fontStyle=1;fontFamily=Helvetica;" edge="1" parent="1" source="10" target="24">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
        <mxCell id="29" value="Gói tin LoRa Uplink (RF 433 MHz)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f172a;strokeWidth=2.5;endArrow=block;endFill=1;fontColor=#0f172a;fontSize=22;fontStyle=1;fontFamily=Helvetica;" edge="1" parent="1" source="25" target="15">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
        <mxCell id="30" value="Đặc tính tự chủ: End-Node tự động dự đoán và chuyển kênh cục bộ trong &lt; 15 ms, hoàn toàn không cần gói tin Downlink từ Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=2;fontColor=#1e293b;fontSize=24;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
  <mxGeometry x="120" y="1070" width="1610" height="65" as="geometry" />
</mxCell>
