        <mxCell id="9" value="MUTEX BẢO VỆ DỮ LIỆU (historyMutex) Bảo toàn tính nhất quán của mảng FIFO 10x9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontColor=#b45309;fontSize=11;arcSize=8;" vertex="1" parent="1">
