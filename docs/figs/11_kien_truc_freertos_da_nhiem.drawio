<mxfile host="app.diagrams.net" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="diagram_page" name="Kiến Trúc Firmware FreeRTOS">
    <mxGraphModel dx="1000" dy="550" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="550" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="KIẾN TRÚC FIRMWARE ĐA NHIỆM THỜI GIAN THỰC FREERTOS TRÊN ESP32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=15;shadow=1;arcSize=10;" vertex="1" parent="1">
  <mxGeometry x="50" y="20" width="900" height="40" as="geometry" />
</mxCell>
        <mxCell id="3" value="CORE 0 (ESP32): THU THẬP CẢM BIẾN &amp; HIỂN THỊ HMI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#bae6fd;strokeWidth=1.5;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#0369a1;arcSize=6;" vertex="1" parent="1">
  <mxGeometry x="60" y="80" width="420" height="440" as="geometry" />
</mxCell>
        <mxCell id="4" value="Task_Sampler (Mức ưu tiên 1)
- Đọc cảm biến mô phỏng
- Ghi nhận thông số gói tin
- Cập nhật bộ đệm trượt FIFO (10x9)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0369a1;fontSize=11;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="80" y="130" width="380" height="85" as="geometry" />
</mxCell>
        <mxCell id="5" value="Task_OLED (Mức ưu tiên 1)
- Chu kỳ quét hiển thị 10 Hz
- Cập nhật màn hình SSD1306 (I2C)
- Hiển thị: Kênh hiện tại, PDR, RSSI, SNR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0369a1;fontSize=11;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="80" y="250" width="380" height="85" as="geometry" />
</mxCell>
        <mxCell id="6" value="CORE 1 (ESP32): SUY LUẬN TINYML &amp; TRUYỀN THÔNG RF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#bbf7d0;strokeWidth=1.5;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#15803d;arcSize=6;" vertex="1" parent="1">
  <mxGeometry x="520" y="80" width="420" height="440" as="geometry" />
</mxCell>
        <mxCell id="7" value="Task_TinyML (Mức ưu tiên 2)
- Chuẩn hóa Z-Score bộ đệm 10x9
- Thực thi suy luận TFLite Micro (&lt; 10 ms)
- ArgMax xác định kênh sạch nhất" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#15803d;fontSize=11;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="540" y="130" width="380" height="85" as="geometry" />
</mxCell>
        <mxCell id="8" value="Task_LoRaTX (Mức ưu tiên 3 - Cao nhất)
- Nhận chỉ số kênh từ Queue
- Cấu hình tần số Ra-02 (LoRa.setFrequency)
- Đóng gói bản tin và phát sóng RF (+17 dBm)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#15803d;fontSize=11;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="540" y="250" width="380" height="85" as="geometry" />
</mxCell>
        <mxCell id="9" value="MUTEX BẢO VỆ DỮ LIỆU
(historyMutex)
Bảo toàn tính nhất quán của mảng FIFO 10x9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontColor=#b45309;fontSize=11;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="80" y="380" width="380" height="70" as="geometry" />
</mxCell>
        <mxCell id="10" value="FREE RTOS QUEUE
(channelQueue - Độ dài 1)
Chuyển giao chỉ số kênh tối ưu (0, 1, 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#6366f1;strokeWidth=1.5;fontColor=#4338ca;fontSize=11;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="540" y="380" width="380" height="70" as="geometry" />
</mxCell>
        <mxCell id="11" value="Khóa Mutex ghi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.8;endArrow=block;endFill=1;fontColor=#334155;fontSize=11;" edge="1" parent="1" source="4" target="9">
