</mxCell>
        <mxCell id="12" value="Khóa Mutex đọc an toàn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.8;endArrow=block;endFill=1;fontColor=#334155;fontSize=11;" edge="1" parent="1" source="9" target="7">
  <mxGeometry relative="1" as="geometry" />
